# Splunk dashboard review targets.
#
# SPLUNK_DASHBOARD_COUNT controls the number of numbered dashboard entries.
#
# Per-dashboard review behavior:
#   REQUIRED_REVIEW=true  -> dashboard must be explicitly marked reviewed before APPROVE
#   NOTE_REQUIRED=true    -> dashboard must also have a non-empty reviewer note
#   ORDER                 -> positive unique integer controlling display order
#
# rules.yml provides the defaults:
#   required_review=true
#   note_required=false
#
# The values below are explicit so the runtime configuration is easy to review.

SPLUNK_DASHBOARD_COUNT=<TBD>

SPLUNK_DASHBOARD_1_ID=<TBD>
SPLUNK_DASHBOARD_1_DISPLAY_NAME=<TBD>
SPLUNK_DASHBOARD_1_URL=<TBD>
SPLUNK_DASHBOARD_1_REQUIRED_REVIEW=true
SPLUNK_DASHBOARD_1_NOTE_REQUIRED=false
SPLUNK_DASHBOARD_1_ORDER=1

SPLUNK_DASHBOARD_2_ID=<TBD>
SPLUNK_DASHBOARD_2_DISPLAY_NAME=<TBD>
SPLUNK_DASHBOARD_2_URL=<TBD>
SPLUNK_DASHBOARD_2_REQUIRED_REVIEW=true
SPLUNK_DASHBOARD_2_NOTE_REQUIRED=false
SPLUNK_DASHBOARD_2_ORDER=2