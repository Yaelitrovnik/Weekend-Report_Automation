# Dynamic sites: repeat for N=1..SITE_COUNT; two sample sites follow.
# RABBITMQ_SITE<N>_URL, RABBITMQ_SITE<N>_USER, RABBITMQ_SITE<N>_PASSWORD
# RABBITMQ_SITE<N>_TLS_VERIFY, RABBITMQ_SITE<N>_CA_FILE
# Remove blocks above SITE_COUNT. Each site's queues and nodes are checked independently.

# RabbitMQ Management API deployment settings.
#
# TLS:
#   true      = use the container's normal trusted CA store
#   custom_ca = use the CA file specified by RABBITMQ_SITE*_CA_FILE
#
# TLS verification must not be disabled in production.

RABBITMQ_COLLECTION_MODE=live

RABBITMQ_SITE1_URL=<TBD>
RABBITMQ_SITE1_USER=<TBD>
RABBITMQ_SITE1_PASSWORD=<TBD>
RABBITMQ_SITE1_TLS_VERIFY=true
RABBITMQ_SITE1_CA_FILE=

RABBITMQ_SITE2_URL=<TBD>
RABBITMQ_SITE2_USER=<TBD>
RABBITMQ_SITE2_PASSWORD=<TBD>
RABBITMQ_SITE2_TLS_VERIFY=true
RABBITMQ_SITE2_CA_FILE=
# Node resources use GET /api/nodes, including sockets_used and sockets_total.
# A missing/null/nonpositive capacity (including 0/0) is an unavailable metric,
# never zero percent or PASS. Required checks remain ERROR until measurement works.
# No credential or resource-limit fallback is inferred. See docs/RELEASE_v1.5.3.md.
