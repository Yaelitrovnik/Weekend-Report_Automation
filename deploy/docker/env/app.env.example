# Application runtime, database, and browser-integrity settings.

WEEKEND_REPORT_APP_VERSION=<TBD>
WEEKEND_REPORT_BUILD_ID=<TBD>
WEEKEND_REPORT_GIT_COMMIT=<NOT_APPLICABLE>

WEEKEND_REPORT_CONFIG_DIR=/app/config
WEEKEND_REPORT_EVIDENCE_ROOT=/app/runs
WEEKEND_REPORT_WORKER_POLL_SECONDS=5

POSTGRES_DB=weekend_report
POSTGRES_USER=weekend_report
POSTGRES_PASSWORD=<TBD>
WEEKEND_REPORT_DATABASE_URL=postgresql://weekend_report:<TBD>@postgres:5432/weekend_report

# CSRF protection for browser mutations. No user login/authentication is used.
WEEKEND_REPORT_CSRF_SIGNING_KEY=<TBD>
WEEKEND_REPORT_CSRF_TTL_SECONDS=3600

# Required manual database synchronization review.
#
# The script executes locally on the reviewer's Windows workstation.
# Weekend Report does not execute this script on the server.

WEEKEND_REPORT_DB_MANUAL_CHECK_ENABLED=true
WEEKEND_REPORT_DB_MANUAL_CHECK_DISPLAY_NAME=Database Synchronization Check
WEEKEND_REPORT_DB_MANUAL_CHECK_SCRIPT_PATH=C:\Scripts\DatabaseSync\database_sync_check.ps1
WEEKEND_REPORT_DB_MANUAL_CHECK_REQUIRED=true
