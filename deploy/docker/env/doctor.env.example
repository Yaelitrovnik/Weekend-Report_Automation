# Runtime inventory: keep only N=1..SITE_COUNT; one site is supported.
DOCTOR_MODE=api

# REQUIRED: copy the verified JSON backend request URL from DevTools Network.
# Do not use the UI URL /doctor#/healthchecks; URL fragments are rejected.
# Existing adapter contract (verify against the real response before using):
# JSON list of {name, status, entries?}; status Healthy/Degraded/Unhealthy or 2/1/0.
# No actual endpoint or production schema has been supplied for v1.5.3.
DOCTOR_SITE1_API_URL=<VERIFIED_DOCTOR_HEALTHCHECK_API_URL>
DOCTOR_SITE1_AUTH_TYPE=none
# Auth choices: none, bearer_token, x_api_key, basic. Set the actual required auth.
DOCTOR_SITE1_TOKEN=
DOCTOR_SITE1_USERNAME=
DOCTOR_SITE1_PASSWORD=
DOCTOR_SITE1_TLS_VERIFY=true
# For an internal CA: TLS_VERIFY=custom_ca and a read-only mounted CA file path.
DOCTOR_SITE1_CA_FILE=

# Remove this block when SITE_COUNT=1; extend it for additional sites.
DOCTOR_SITE2_API_URL=<VERIFIED_DOCTOR_HEALTHCHECK_API_URL>
DOCTOR_SITE2_AUTH_TYPE=none
DOCTOR_SITE2_TOKEN=
DOCTOR_SITE2_USERNAME=
DOCTOR_SITE2_PASSWORD=
DOCTOR_SITE2_TLS_VERIFY=true
DOCTOR_SITE2_CA_FILE=
